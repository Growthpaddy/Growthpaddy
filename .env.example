# ==============================================================================
# ENVIRONMENT CONFIGURATION & SECURITY BLUEPRINT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Safe to expose in browser bundles)
# ------------------------------------------------------------------------------
# Supabase API URL & Public Anon Key
# Protected via PostgreSQL Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Vite compatibility aliases (if using Vite build pipeline)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER-ONLY SECRETS (CRITICAL: NEVER PREFIX WITH NEXT_PUBLIC_ OR VITE_)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses all PostgreSQL Row Level Security)
# MUST only be used in Node.js server environments or Edge functions.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Secret Administrative Invite Code
# Validated strictly on the server using crypto.timingSafeEqual.
ADMIN_INVITE_CODE="YOUR_STRONG_RANDOM_ADMIN_INVITE_SECRET_2026"

# ------------------------------------------------------------------------------
# 3. APPLICATION & AI PLATFORM CONFIGURATION
# ------------------------------------------------------------------------------
# Server-side Gemini AI Key
GEMINI_API_KEY="your-gemini-api-key-here"

# App Deployment Host URL
APP_URL="https://your-domain.com"


